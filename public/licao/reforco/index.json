[
 {
  "id": "was-were",
  "title": "Was ou were?",
  "match": {
   "said": "\\bwas\\b",
   "right": "\\bwere\\b"
  }
 },
 {
  "id": "if-had-would",
  "title": "If I had… I would…",
  "match": {
   "said": "\\bif\\b.*\\b(have|has|am|is|are|don't|doesn't)\\b",
   "right": "\\bif\\b.*\\b(had|were|didn't)\\b"
  }
 },
 {
  "id": "would-sem-to",
  "title": "Would + verbo sem to",
  "match": {
   "said": "\\b(would|wouldn't|would not) to\\b",
   "right": "\\b(would|wouldn't)\\b"
  }
 }
]